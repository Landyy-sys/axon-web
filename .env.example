# ─────────────────────────────────────────────────────────────
# AXON 环境变量模板
#   本地：复制成 .env（不要提交），Node 22 可用 `node --env-file=.env server.mjs`
#   云端：在 Render → Environment 里逐条填写，键名保持完全一致
#   一条都不填也能跑：/api/segment 返回 501，前端自动回退浏览器端识别
# ─────────────────────────────────────────────────────────────

# 端口（本地留空即用 4173；Render 会自动注入，不要手填）
# PORT=4173

# 百度智能云 · 图像分割（可选，云端高精度杂物识别）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 阿里云 · 视觉智能（可选，配了则优先走阿里云）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 强制只往控制台打日志（云端自动开启，本地调试也可手动开）
# AXON_LOG=console
