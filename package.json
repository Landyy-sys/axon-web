{
  "name": "axon-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lan": "vite build && vite preview",
    "lan:dev": "vite",
    "ip": "node scripts/print-lan-url.mjs",
    "deploy:check": "node scripts/check-deploy.mjs",
    "single": "vite build --config vite.single.config.js && node scripts/bundle-single.mjs",
    "bench": "node scripts/benchmark.mjs",
    "check": "node scripts/check-model.mjs",
    "detect": "node scripts/detect-check.mjs",
    "smoke": "vite build --ssr scripts/ssr-check.jsx --outDir dist-ssr --logLevel error && node dist-ssr/ssr-check.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
